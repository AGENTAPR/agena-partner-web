# Client-safe variables (bundled) — never put secrets here.
VITE_STORAGE_PREFIX="nx"
VITE_MUIX_LICENSE_KEY=

# Server-only bindings (never VITE_*, never committed with real values).
# Used by `react-router dev` via process.env fallback and by the Worker
# via wrangler vars/secrets.
AGENT_BFF_BASE_URL=https://<agent-bff-host>
AGENT_BFF_TIMEOUT_MS=10000
# Optional machine-to-machine token if the BFF contract requires it.
# AGENT_BFF_INTERNAL_TOKEN=
# SESSION_SECRET=           # required for signed-cookie sessions in prod

# Live E2E (Playwright) — real Keycloak demo account, never commit passwords.
# E2E_KC_USERNAME=demo.agent.1
# E2E_KC_PASSWORD=
